{
  "apiType": "stageMode",
  "buildOption": {
    "arkOptions": {
      // "apPath": "./modules.ap"  /* Profile used for profile-guided optimization (PGO), a compiler optimization technique to improve app runtime performance. */
    },
    "externalNativeOptions": {
      "abiFilters": [
        "arm64-v8a"
      ]
    },
    "nativeLib": {
      "collectAllLibs": true
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    },
  ],
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS",
      "config": {
        "deviceType": [
          "phone",
          "tablet",
          "2in1"
        ]
      },
      "source": {
        "pages": [
          "pages/Index",
        ]
      }
    }
  ]
}